class Solution:
    def maxSubarrayLength(self, nums: List[int], k: int) -> int:
        c= defaultdict(int)
        l=0
        res=0
        for i in range(len(nums)):
            c[nums[i]]+=1
            while c[nums[i]]>k:
                c[nums[l]]-=1
                l+=1
                
            res=max(res,(i-l)+1)

        return res
