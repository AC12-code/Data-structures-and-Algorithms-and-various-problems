class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        abc=defaultdict(int)
        left=0
        t=0
        maxf=0
        for i in range(len(s)):
            abc[s[i]]+=1
            maxf=max(maxf,abc[s[i]])
            while (i-left+1)-maxf>k:
                abc[s[left]]-=1
                left+=1        
            t=max(t,i-left+1)
        return t
