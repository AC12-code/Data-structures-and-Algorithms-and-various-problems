class Solution:
    def numOfMinutes(self, n: int, headID: int, manager: List[int], informTime: List[int]) -> int:
        adj = defaultdict(list)

        for i in range(n):
            if manager[i] != -1:
                adj[manager[i]].append(i)

        def dfs(i):
            if not adj[i]:         
                return 0

            max_time = 0

            for j in adj[i]:
                max_time = max(max_time, dfs(j))

            return informTime[i] + max_time

        return dfs(headID)
